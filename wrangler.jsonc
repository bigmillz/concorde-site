{
  // Cloudflare Workers Static Assets. The site is plain files with no build
  // step, so there is no build command and no output directory — the repo
  // root IS the site, and .assetsignore keeps the tooling out of it.
  //
  // run_worker_first: without it, a request that matches a static file is
  // served before worker.js runs, so the security headers would never reach
  // the pages people actually load.
  "name": "concorde-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-12",
  // The contact form's mail. Deliberately NO destination here: this repo is
  // public, so the address lives only in the CONTACT_TO Worker secret. The
  // binding can send to any address verified in Email Routing. Without the
  // secret, worker.js takes the form off the page.
  "send_email": [{ "name": "CONTACT" }],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
